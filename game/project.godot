config_version=5

[application]
config/name="Horde Shooter - Stage 1"
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/branding/app-icon.png"
config/windows_native_icon="res://assets/branding/app-icon.ico"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]
project/assembly_name="HordeShooter"

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Props"
3d_physics/layer_5="Corpse"

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.05, 1)
