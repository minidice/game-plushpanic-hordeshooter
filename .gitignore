# Generated caches, dependencies and local agent state
**/.godot/
**/node_modules/
**/bin/
**/obj/
**/.omc/
**/output/*
!**/output/.gitkeep
# Keeps Godot from importing check renders as game assets (an import once crashed on them)
!**/output/.gdignore
**/__pycache__/
**/.pytest_cache/
**/.vs/
**/.idea/

# Machine-local settings, credentials and transient output
.env
.env.*
!.env.example
*.user
*.suo
*.log
*.tmp
*.blend1
*.blend2
Thumbs.db
.DS_Store

# Exported game for other PCs (game/Export-Game.cmd)
build/

# Feedback pack output (studio/share/README.md): photos, GLBs, scene shots, packs and zips
studio/share/.build/
studio/share/packs/
