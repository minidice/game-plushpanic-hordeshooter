config_version=5

[application]
config/name="Plush Panic · Outdoor Asset Lab"
run/main_scene="res://preview/Preview.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=900
window/size/window_width_override=1100
window/size/window_height_override=774

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.065,0.09,0.10,1)
